{
  "name": "eva",
  "displayName": "Eva",
  "description": "The eva rice for VS Code: one colour theme per setup (Unit-01 / NERV HQ) and a title-card date in the status bar. Colours come from theme/setups/*.json.",
  "version": "2.0.0",
  "publisher": "eva",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Eva Unit-01",
        "uiTheme": "vs-dark",
        "path": "./themes/eva-unit01-color-theme.json"
      },
      {
        "label": "Eva NERV HQ",
        "uiTheme": "vs-dark",
        "path": "./themes/eva-magi-color-theme.json"
      }
    ],
    "commands": [
      {
        "command": "eva.focus",
        "title": "Eva: Entry plug (focus) mode"
      },
      {
        "command": "eva.date",
        "title": "Eva: Today"
      }
    ],
    "colors": [],
    "snippets": [
      {
        "language": "c",
        "path": "./snippets/c.json"
      },
      {
        "language": "cpp",
        "path": "./snippets/c.json"
      },
      {
        "language": "asm-intel-x86-generic",
        "path": "./snippets/asm.json"
      },
      {
        "language": "linkerscript",
        "path": "./snippets/ld.json"
      }
    ],
    "keybindings": [
      {
        "command": "eva.focus",
        "key": "ctrl+k ctrl+n"
      }
    ]
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0f1331",
    "theme": "dark"
  }
}
