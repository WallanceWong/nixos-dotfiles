// eva — boot splash: Unit-01 in the dark, its eye coming on green, an
// activation line and a sync bar. Same in both setups (the boot login is
// always Eva-01). Also asks for a disk password, if there ever is one.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

W = Window.GetWidth();
H = Window.GetHeight();
scale = Math.Min(W / 1920, H / 1200);

head.image = Image("unit01.png");
head.image = head.image.Scale(head.image.GetWidth() * scale, head.image.GetHeight() * scale);
head.sprite = Sprite(head.image);
head.sprite.SetX(W * 0.5 - head.image.GetWidth() * 0.5);
head.sprite.SetY(H * 0.40 - head.image.GetHeight() * 0.5);
head.sprite.SetOpacity(0);

glow.image = Image("eye.png");
glow.image = glow.image.Scale(glow.image.GetWidth() * scale, glow.image.GetHeight() * scale);
glow.sprite = Sprite(glow.image);
// the eye sits at (eyeX, eyeY) inside unit01.png (see default.nix)
glow.sprite.SetX(head.sprite.GetX() + EYE_X * scale - glow.image.GetWidth() * 0.5);
glow.sprite.SetY(head.sprite.GetY() + EYE_Y * scale - glow.image.GetHeight() * 0.5);
glow.sprite.SetZ(2);
glow.sprite.SetOpacity(0);

title.image = Image("title.png");
title.image = title.image.Scale(title.image.GetWidth() * scale, title.image.GetHeight() * scale);
title.sprite = Sprite(title.image);
title.sprite.SetX(W * 0.5 - title.image.GetWidth() * 0.5);
title.sprite.SetY(H * 0.74);
title.sprite.SetOpacity(0);

barW = 520 * scale;
track.image = Image("track.png").Scale(barW, 4 * scale);
track.sprite = Sprite(track.image);
track.sprite.SetX(W * 0.5 - barW * 0.5);
track.sprite.SetY(H * 0.74 + title.image.GetHeight() + 22 * scale);
fill.base = Image("fill.png");
fill.sprite = Sprite();
fill.sprite.SetX(track.sprite.GetX());
fill.sprite.SetY(track.sprite.GetY());
fill.sprite.SetZ(3);

t = 0;
progress = 0;
fun refresh() {
    t++;
    head.sprite.SetOpacity(Math.Min(1, t / 50));
    // the eye: dark for a moment, flickers on, then breathes
    if (t < 40) e = 0;
    else if (t < 46) e = (t % 2) * 0.8;
    else e = 0.75 + 0.25 * Math.Sin(t / 12);
    glow.sprite.SetOpacity(e);
    title.sprite.SetOpacity(Math.Min(1, Math.Max(0, (t - 30) / 40)));
    w = Math.Max(1, Math.Int(barW * progress));
    fill.sprite.SetImage(fill.base.Scale(w, 4 * scale));
}
Plymouth.SetRefreshFunction(refresh);
fun on_progress(duration, p) { progress = p; }
Plymouth.SetBootProgressFunction(on_progress);

// ── disk password (LUKS), one block per character ──
prompt.sprite = Sprite();
bullets = [];
fun on_password(prompt_text, count) {
    prompt.sprite.SetImage(Image.Text("PILOT AUTHENTICATION · " + prompt_text, 0.61, 0.89, 0.29, 1, "Barlow Condensed Bold 16"));
    prompt.sprite.SetX(W * 0.5 - prompt.sprite.GetImage().GetWidth() * 0.5);
    prompt.sprite.SetY(track.sprite.GetY() + 30 * scale);
    for (i = 0; bullets[i] || i < count; i++) {
        if (!bullets[i]) bullets[i] = Sprite(Image("fill.png").Scale(10 * scale, 18 * scale));
        bullets[i].SetX(W * 0.5 - count * 7 * scale + i * 14 * scale);
        bullets[i].SetY(prompt.sprite.GetY() + 34 * scale);
        bullets[i].SetOpacity(i < count);
    }
}
Plymouth.SetDisplayPasswordFunction(on_password);
fun on_normal() {
    prompt.sprite.SetOpacity(0);
    for (i = 0; bullets[i]; i++) bullets[i].SetOpacity(0);
}
Plymouth.SetDisplayNormalFunction(on_normal);
