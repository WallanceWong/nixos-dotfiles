/* whisper — launcher */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 11";
    drun-display-format: "{name}";
    display-drun: "";
    display-run: "";
    display-window: "";
}

* {
    base:     #071a28e6;
    surface0: #0c2a3d;
    surface1: #13384e;
    overlay:  #3f6e74;
    subtext:  #9fb5bd;
    text:     #e3e8e1;
    lamp:     #f0e3a8;
    teal:     #7fc3c6;

    background-color: transparent;
    text-color: @text;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 580px;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @lamp;
    border-radius: 18px;
    background-color: @base;
}

mainbox {
    padding: 18px;
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 16px;
    spacing: 12px;
    border-radius: 12px;
    background-color: @surface0;
    children: [ prompt, entry ];
}

prompt {
    text-color: @lamp;
}

entry {
    placeholder: "where to tonight?";
    placeholder-color: @subtext;
    cursor-color: @lamp;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 9px 12px;
    spacing: 14px;
    border-radius: 10px;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @surface1;
    text-color: @lamp;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

message {
    padding: 10px 14px;
    border-radius: 10px;
    background-color: @surface0;
}
