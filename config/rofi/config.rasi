/* eva — rescue launcher */

configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    font: "JetBrainsMono Nerd Font 11";
    drun-display-format: "{name}";
    display-drun: "󰖔";
    display-run: "";
    display-window: "";
}

* {
    base:     #0f1331e6;
    surface0: #172044;
    surface1: #1e2a56;
    overlay:  #4b5c8c;
    subtext:  #a7b2cf;
    text:     #e8e5e1;
    lamp:     #9be34a;
    teal:     #9a7fe6;

    background-color: transparent;
    text-color: @text;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 580px;
    location: center;
    anchor: center;
    border: 2px;
    border-color: @lamp;
    border-radius: 2px;
    background-color: @base;
}

mainbox {
    padding: 18px;
    spacing: 14px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 12px 16px;
    spacing: 12px;
    border-radius: 2px;
    background-color: @surface0;
    children: [ prompt, entry ];
}

prompt {
    text-color: @lamp;
}

entry {
    placeholder: "where to tonight?";
    placeholder-color: @subtext;
    cursor-color: @lamp;
}

listview {
    lines: 7;
    columns: 1;
    fixed-height: true;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 9px 12px;
    spacing: 14px;
    border-radius: 2px;
}

element normal.normal, element alternate.normal,
element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @text;
}

element selected.normal, element selected.active {
    background-color: @surface1;
    text-color: @lamp;
}

element-icon {
    size: 26px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}

message {
    padding: 10px 14px;
    border-radius: 2px;
    background-color: @surface0;
}
