# whisper — notifications drift in like a note passed at night
font=JetBrainsMono Nerd Font 10.5
background-color=#071a28e0
text-color=#e3e8e1
border-color=#f0e3a8
border-size=2
border-radius=14
padding=14,16
margin=14
outer-margin=6
width=380
height=180
icons=1
max-icon-size=44
icon-path=/run/current-system/sw/share/icons/Papirus-Dark
icon-location=left
progress-color=over #7fc3c655
default-timeout=5000
layer=overlay
format=<b>%s</b>\n<span foreground="#9fb5bd">%b</span>

[urgency=low]
border-color=#3f6e74

[urgency=critical]
border-color=#e0786c
default-timeout=0

# volume / brightness popups from ~/nixos-dotfiles/config/hypr/osd.sh
[app-name=osd]
anchor=bottom-center
outer-margin=0,0,60,0
width=300
height=72
border-color=#7fc3c6
max-icon-size=28
progress-color=over #7fc3c650
format=<b>%s</b>   <span foreground="#9fb5bd">%b</span>
