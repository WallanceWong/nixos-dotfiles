# eva — rescue notifications (Super+Ctrl+B)
font=JetBrainsMono Nerd Font 10.5
background-color=#0f1331e0
text-color=#e8e5e1
border-color=#9be34a
border-size=2
border-radius=0
padding=14,16
margin=14
outer-margin=6
width=380
height=180
icons=1
max-icon-size=44
icon-path=/run/current-system/sw/share/icons/Papirus-Dark
icon-location=left
progress-color=over #9a7fe655
default-timeout=5000
layer=overlay
format=<b>%s</b>\n<span foreground="#a7b2cf">%b</span>

[urgency=low]
border-color=#4b5c8c

[urgency=critical]
border-color=#ff5d73
default-timeout=0

# volume / brightness popups from ~/nixos-dotfiles/config/hypr/osd.sh
[app-name=osd]
anchor=bottom-center
outer-margin=0,0,60,0
width=300
height=72
border-color=#9a7fe6
max-icon-size=28
progress-color=over #9a7fe650
format=<b>%s</b>   <span foreground="#a7b2cf">%b</span>
