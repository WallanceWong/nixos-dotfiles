{
  "workbench.colorTheme": "Whisper",
  "workbench.iconTheme": "material-icon-theme",
  "editor.fontFamily": "'Maple Mono NF', 'Noto Sans Mono CJK SC', 'JetBrainsMono Nerd Font', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": "'calt', 'cv01', 'ss02'",
  "editor.lineHeight": 1.65,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "editor.minimap.enabled": true,
  "editor.renderLineHighlight": "all",
  "editor.padding.top": 14,
  "terminal.integrated.fontFamily": "'Maple Mono NF', 'Noto Sans Mono CJK SC'",
  "terminal.integrated.cursorStyle": "line",
  "window.menuBarVisibility": "toggle",
  "window.commandCenter": true,
  "workbench.startupEditor": "none",
  "clangd.path": "clangd",
  "clangd.checkUpdates": false,
  "clangd.arguments": [
    "--background-index",
    "--header-insertion=never",
    "-j=8"
  ],
  "[c]": {
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.rulers": [
      80,
      100
    ]
  },
  "[asm]": {
    "editor.tabSize": 8,
    "editor.insertSpaces": false
  },
  "files.trimTrailingWhitespace": true,
  "nix.enableLanguageServer": false,
  "files.autoSave": "afterDelay",
  "workbench.productIconTheme": "Default",
  "editor.letterSpacing": 0.2,
  "editor.fontWeight": "400",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "terminal.integrated.smoothScrolling": true,
  "editor.padding.bottom": 14,
  "editor.roundedSelection": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.maxColumn": 90,
  "editor.minimap.scale": 1,
  "editor.minimap.showSlider": "mouseover",
  "editor.scrollbar.verticalScrollbarSize": 10,
  "editor.scrollbar.horizontalScrollbarSize": 10,
  "editor.stickyScroll.enabled": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.guides.highlightActiveIndentation": true,
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.semanticHighlighting.enabled": true,
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.renderWhitespace": "trailing",
  "editor.linkedEditing": true,
  "editor.suggest.preview": true,
  "editor.hover.delay": 400,
  "editor.occurrencesHighlightDelay": 150,
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.tree.enableStickyScroll": true,
  "workbench.editor.tabActionLocation": "right",
  "workbench.editor.highlightModifiedTabs": true,
  "workbench.editor.decorations.colors": true,
  "workbench.editor.decorations.badges": true,
  "workbench.layoutControl.enabled": false,
  "workbench.tips.enabled": false,
  "workbench.reduceMotion": "off",
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": true,
  "window.titleBarStyle": "custom",
  "window.dialogStyle": "custom",
  "window.title": "${dirty}${activeEditorShort}${separator}${rootName}",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.2,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.minimumContrastRatio": 1,
  "terminal.integrated.gpuAcceleration": "on",
  "terminal.integrated.stickyScroll.enabled": true,
  "zenMode.centerLayout": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.showTabs": "single",
  "material-icon-theme.folders.color": "#7fc3c6",
  "material-icon-theme.files.color": "#9fb5bd",
  "material-icon-theme.saturation": 0.75,
  "material-icon-theme.opacity": 0.95,
  "material-icon-theme.folders.theme": "specific",
  "material-icon-theme.hidesExplorerArrows": false,
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info"
  ],
  "errorLens.fontStyleItalic": true,
  "errorLens.messageBackgroundMode": "message",
  "errorLens.padding": "1px 6px",
  "errorLens.borderRadius": "6px",
  "errorLens.margin": "2ch",
  "errorLens.gutterIconsEnabled": true,
  "errorLens.gutterIconSet": "circle",
  "errorLens.delay": 300,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "onboarding.enabled": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.c": "${capture}.o, ${capture}.d, ${capture}.i, ${capture}.s.o",
    "*.s": "${capture}.o",
    "*.asm": "${capture}.o",
    "*.cpp": "${capture}.o, ${capture}.d",
    "Makefile": "*.mk, .clang-format, .clangd, compile_commands.json, bochsrc.txt, bochslog.txt",
    "flake.nix": "flake.lock, .envrc, shell.nix, default.nix",
    "*.ld": "*.map",
    "README.md": "LICENSE, CHANGELOG.md, *.md",
    "kernel.elf": "kernel.bin, *.sym, os.iso"
  },
  "accessibility.dimUnfocused.enabled": true,
  "accessibility.dimUnfocused.opacity": 0.78,
  "editor.minimap.autohide": "mouseover",
  "terminal.integrated.tabs.defaultColor": "terminal.ansiCyan",
  "terminal.integrated.tabs.defaultIcon": "terminal-bash"
}
